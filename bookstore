include <iostream>
#include <string>
using namespace std;

class book
{

public:

 int id;
 string name;
 float price;
 string language;

 void input()

{

 cout<<"enter id of book:";
 cin>>id;

 cout<<"enter name of book:";
 cin>>name;

cout<<"enter price of book:";
 cin>>price;

 cout<<"enter language of book:";
 cin>>language;

}

 void disp()

{

 cout<<"id:"<<id<<endl;
 cout<<"name:"<<name<<endl;
 cout<<"price:"<<price<<endl;
 cout<<"language:"<<language<<endl;

}
};

int main()

{

  book b1,b2;

 b1.input();
 b1.disp();

 b2.input();
 b2.disp();

return 0;

}


